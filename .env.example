# Copia questo file in `.env` (mai committare il file reale).
# Lo legge sia il backend in locale sia Docker Compose.

# --- Obbligatorio -----------------------------------------------------------
# Chiave di firma dei JWT: almeno 32 caratteri casuali, unica per installazione.
# Generala con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# --- Sviluppo locale (uvicorn + Vite) ---------------------------------------
# In Docker DATABASE_URL e FRONTEND_ORIGINS sono impostati da compose.yaml.
DATABASE_URL=sqlite:///./database/studyos.db
FRONTEND_ORIGINS=http://localhost:5173

# --- Comuni ------------------------------------------------------------------
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# development: cookie senza flag Secure (necessario su http://).
# production: cookie Secure, solo dietro HTTPS.
APP_ENV=development

# --- Docker (facoltativi) ----------------------------------------------------
# Porta su cui aprire StudyOS: http://localhost:8080
# STUDYOS_PORT=8080
# Origine pubblica, se diversa da http://localhost:<STUDYOS_PORT>
# STUDYOS_ORIGIN=https://studyos.example.org
# Limiti di risorse dei container (valori prudenti, vedi README)
# API_MEMORY_LIMIT=256M
# API_CPUS=1.0
# WEB_MEMORY_LIMIT=64M
# WEB_CPUS=0.5
